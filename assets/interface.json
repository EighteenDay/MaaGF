{
    "interface_version": 2,
    "name": "MaaGF",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/EighteenDay/MaaGF.git",
    "version": "1.0.1",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "少女前线",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "少女前线",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "宿舍任务",
            "entry": "!Dormitory_Entry",
            "option": [
                "Dormitory_Task_List"
            ]
        },
        {
            "name": "进入",
            "entry": "进入宿舍"
        }
    ],
    "option": {
        "Dormitory_Task_List": {
            "type": "select",
            "cases": [
                {
                    "name": "好友点赞偷电",
                    "pipeline_override": {
                        "!Dormitory_Entry": {
                            "next": "!宿舍自动点赞"
                        }
                    }
                },
                {
                    "name": "宿舍点击爱心",
                    "pipeline_override": {
                        "!Dormitory_Entry": {
                            "next": "!点击爱心"
                        }
                    }
                }
            ]
        }
    }
}